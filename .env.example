# Copy to .env and fill in. .env is gitignored - never commit it.
#
#   [optional] the code has a working default; uncomment only to override
#   [prod]     read by docker-compose.prod.yml, not needed for local dev

# ------------------------------------------------------------------ database
# Local dev points at the postgres from docker-compose.yml.
# In production docker-compose.prod.yml composes this from POSTGRES_* below
# and overrides whatever is set here.
DB_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot

# [prod] Credentials for the postgres container, and for the DB_URL built from them.
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# -------------------------------------------------------------- vector store
# Local dev: the qdrant from docker-compose.yml, no key needed.
# Qdrant Cloud: the cluster URL plus its key. Setting the key is what makes both
# the message store and Mem0 use the cloud client instead of host/port.
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_API_KEY=

# ---------------------------------------------------------------------- auth
# openssl rand -base64 32
JWT_SECRET=
# [optional] JWT_ALGORITHM=HS256
# [optional] ACCESS_TOKEN_TTL_MINUTES=30

# ----------------------------------------------------------- llm / embeddings
# Google AI Studio key, used through the OpenAI-compatible endpoint.
LLM_API_KEY=
# [optional] LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# [optional] LLM_MODEL=gemini-3.5-flash-lite
# [optional] EMBEDDING_MODEL=gemini-embedding-001
# [optional] EMBEDDING_DIMS=768

# --------------------------------------------------------------------- voice
# LiveKit Cloud project, e.g. wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ElevenLabs voice used for TTS.
ELEVEN_VOICE_ID=
ELEVEN_API_KEY=

# ----------------------------------------------------------------- web tools
# Hosted MCP servers. No API key means that server is simply not loaded.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# [optional] TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# [optional] FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp

# ------------------------------------------------------------- observability
# Read by the LangSmith SDK straight from the environment, not via Settings.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=

# ------------------------------------------------------------------- logging
# [optional] LOG_LEVEL=INFO
# [optional] LOG_FORMAT=json     # json for production, plain for a terminal

# ------------------------------------------------------------------------ ui
# Signs the token stored in gr.BrowserState.
UI_STORAGE_SECRET=
# Where the UI process itself calls the API. Compose sets http://api:8000.
# [optional] API_URL_INTERNAL=http://127.0.0.1:8000
# What the BROWSER loads: the voice iframe plus its postMessage origin check.
# [prod] Must be the public https URL, otherwise voice mode breaks silently.
API_URL_PUBLIC=
# [optional] UI_HOST=127.0.0.1   # compose sets 0.0.0.0 inside the container

# ---------------------------------------------------------------------- caddy
# [prod] Domain Caddy requests the TLS certificate for.
DOMAIN=
